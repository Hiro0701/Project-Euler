   "outputs": [],
   "source": [
    "def find_factorial_digit_sum(n: int) -> int:\n",
    "    factorial = 1\n",
    "    for i in range(1, n+1):\n",
    "        factorial *= i\n",
    "\n",
    "    return sum(\n",
    "        [\n",
    "            int(i) for i in str(factorial)\n",
    "        ]\n",
    "    )"
   ]
  },
